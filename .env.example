# --- Local development (copy to .env) -------------------------------------
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
# At least 32 characters in production: openssl rand -hex 32
SESSION_SECRET=
# Staff PINs (required in production; never reuse development values)
ADMIN_PIN=
KITCHEN_PIN=
CASHIER_PIN=

# --- Production only (/opt/pizza-demo/.env on the VPS, generated by deploy/scripts/server-setup.sh)
# APP_PORT=3066                     # loopback port Nginx proxies to
# APP_IMAGE=ghcr.io/novixa-dev/pizza-demo
# APP_TAG=latest                    # managed by the Deploy workflow
